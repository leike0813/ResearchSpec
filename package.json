{
  "name": "researchspec",
  "version": "0.1.0",
  "description": "Agent-neutral spec-driven framework for ARSU-facing academic writing workflows.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "bin": {
    "researchspec": "./dist/src/cli/main.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/tests/**/*.test.js\"",
    "check": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "arsu:convert": "node dist/src/arsu-converter/cli.js convert",
    "arsu:check": "node dist/src/arsu-converter/cli.js check",
    "arsu:idempotence": "node dist/src/arsu-converter/cli.js idempotence",
    "arsu:anchors:manifest": "node dist/src/arsu-converter/anchors/generate.js",
    "arsu:anchors:check": "node dist/src/arsu-converter/anchors/check.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.37.0",
    "typescript-eslint": "^8.46.1",
    "typescript": "^5.8.0"
  }
}
