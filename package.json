{
  "name": "researchspec",
  "version": "0.1.0",
  "description": "Agent-neutral spec-driven framework for ARSU-facing academic writing workflows.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "exports": {
    "./annotation-intake": {
      "types": "./dist/src/annotation-intake.d.ts",
      "import": "./dist/src/annotation-intake.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "researchspec": "./dist/src/cli/bin.js"
  },
  "files": [
    "dist",
    "!dist/src/vendor-audits",
    "!dist/src/vendor-evidence",
    "!dist/src/vendor-converters",
    "skills",
    "literature-adapters",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "LICENSES",
    "NOTICE",
    "docs",
    "artifacts/release/mvp-release-checklist.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-output.mjs dist .test-dist",
    "build": "node scripts/clean-output.mjs dist && tsc -p tsconfig.build.json && node scripts/mark-cli-executable.mjs",
    "install:stable": "node scripts/install-stable.mjs",
    "test": "node scripts/clean-output.mjs .test-dist && tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "extraction:index": "node scripts/generate-extraction-index.mjs",
    "extraction:index:check": "node scripts/generate-extraction-index.mjs --check",
    "check": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "dev:harness": "node scripts/run-skill-harness.mjs",
    "cli:handbook": "pnpm build && node scripts/generate-docs.mjs --handbook-only",
    "cli:handbook:check": "pnpm build && node scripts/generate-docs.mjs --handbook-only --check",
    "docs:generate": "pnpm build && node scripts/generate-docs.mjs",
    "docs:check": "pnpm build && node scripts/generate-docs.mjs --check",
    "whitespace:check": "node scripts/check-authored-whitespace.mjs",
    "prepack": "pnpm build",
    "release:verify": "node scripts/verify-package.mjs",
    "arsu:author": "pnpm build && node dist/src/arsu-converter/authoring/cli.js author",
    "arsu:convert": "pnpm build && node dist/src/arsu-converter/cli.js convert",
    "arsu:check": "pnpm build && node dist/src/arsu-converter/cli.js check",
    "arsu:idempotence": "pnpm build && node dist/src/arsu-converter/cli.js idempotence",
    "zotero-adapter:convert": "pnpm build && node dist/src/vendor-converters/zotero-library-agent-bundle/cli.js convert",
    "zotero-adapter:audit": "pnpm build && node dist/src/vendor-converters/zotero-library-agent-bundle/cli.js audit",
    "zotero-adapter:check": "pnpm build && node dist/src/vendor-converters/zotero-library-agent-bundle/cli.js check",
    "zotero-adapter:idempotence": "pnpm build && node dist/src/vendor-converters/zotero-library-agent-bundle/cli.js idempotence",
    "arsu:anchors:manifest": "pnpm build && node dist/src/arsu-converter/anchors/generate.js",
    "arsu:anchors:check": "pnpm build && node dist/src/arsu-converter/anchors/check.js",
    "arsu:runtime-policy:check": "pnpm build && node dist/src/arsu-converter/runtime-policy/check.js",
    "tooluniverse:convert": "pnpm build && node dist/src/vendor-converters/tooluniverse/cli.js convert",
    "tooluniverse:check": "pnpm build && node dist/src/vendor-converters/tooluniverse/cli.js check",
    "tooluniverse:idempotence": "pnpm build && node dist/src/vendor-converters/tooluniverse/cli.js idempotence",
    "scientific-agent-skills:convert": "pnpm build && node dist/src/vendor-converters/scientific-agent-skills/cli.js convert",
    "scientific-agent-skills:check": "pnpm build && node dist/src/vendor-converters/scientific-agent-skills/cli.js check",
    "scientific-agent-skills-maintenance:diff": "node scripts/scientific-agent-skills-maintenance.mjs diff",
    "scientific-agent-skills:idempotence": "pnpm build && node dist/src/vendor-converters/scientific-agent-skills/cli.js idempotence",
    "materials-science-skills-for-llm:convert": "pnpm build && node dist/src/vendor-converters/materials-science-skills-for-llm/cli.js convert",
    "materials-science-skills-for-llm:check": "pnpm build && node dist/src/vendor-converters/materials-science-skills-for-llm/cli.js check",
    "materials-science-skills-for-llm:idempotence": "pnpm build && node dist/src/vendor-converters/materials-science-skills-for-llm/cli.js idempotence",
    "finrobot:convert": "pnpm build && node dist/src/vendor-converters/finrobot/cli.js convert",
    "finrobot:check": "pnpm build && node dist/src/vendor-converters/finrobot/cli.js check",
    "finrobot:idempotence": "pnpm build && node dist/src/vendor-converters/finrobot/cli.js idempotence",
    "histagent:convert": "pnpm build && node dist/src/vendor-converters/histagent/cli.js convert",
    "histagent:check": "pnpm build && node dist/src/vendor-converters/histagent/cli.js check",
    "histagent:idempotence": "pnpm build && node dist/src/vendor-converters/histagent/cli.js idempotence",
    "education-agent-skills:audit": "pnpm build && node dist/src/vendor-audits/education-agent-skills-cli.js audit",
    "education-agent-skills:audit:check": "pnpm build && node dist/src/vendor-audits/education-agent-skills-cli.js check",
    "education-agent-skills:evidence:check": "pnpm build && node dist/src/vendor-evidence/education-agent-skills/cli.js check",
    "education-agent-skills:preview": "pnpm build && node dist/src/vendor-converters/education-agent-skills/cli.js preview",
    "education-agent-skills:convert": "pnpm build && node dist/src/vendor-converters/education-agent-skills/cli.js convert",
    "education-agent-skills:check": "pnpm build && node dist/src/vendor-converters/education-agent-skills/cli.js check",
    "education-agent-skills-maintenance:diff": "node scripts/education-agent-skills-maintenance.mjs diff",
    "education-agent-skills:idempotence": "pnpm build && node dist/src/vendor-converters/education-agent-skills/cli.js idempotence",
    "capability:parity": "node scripts/audit-capability-parity.mjs",
    "capability:parity:report": "node scripts/audit-capability-parity.mjs --json artifacts/generated/capability-parity-report.json",
    "capability:review-html": "node scripts/generate-arsu-capability-review-html.mjs",
    "capability:assessment-html": "node scripts/generate-arsu-graph-match-assessment-html.mjs",
    "capability:gap-review-html": "node scripts/generate-arsu-gap-semantic-review-html.mjs",
    "arsu-maintenance:baseline": "node scripts/arsu-maintenance.mjs baseline",
    "arsu-maintenance:check": "node scripts/arsu-maintenance.mjs check",
    "finrobot-maintenance:artifacts": "node scripts/finrobot-maintenance.mjs artifacts",
    "finrobot-maintenance:records": "node scripts/finrobot-maintenance.mjs records",
    "finrobot-maintenance:baseline": "node scripts/finrobot-maintenance.mjs baseline",
    "finrobot-maintenance:check": "node scripts/finrobot-maintenance.mjs check",
    "histagent-maintenance:artifacts": "node scripts/histagent-maintenance.mjs artifacts",
    "histagent-maintenance:records": "node scripts/histagent-maintenance.mjs records",
    "histagent-maintenance:baseline": "node scripts/histagent-maintenance.mjs baseline",
    "histagent-maintenance:check": "node scripts/histagent-maintenance.mjs check",
    "materials-science-skills-for-llm-maintenance:artifacts": "node scripts/materials-science-skills-for-llm-maintenance.mjs artifacts",
    "materials-science-skills-for-llm-maintenance:records": "node scripts/materials-science-skills-for-llm-maintenance.mjs records",
    "materials-science-skills-for-llm-maintenance:baseline": "node scripts/materials-science-skills-for-llm-maintenance.mjs baseline",
    "materials-science-skills-for-llm-maintenance:check": "node scripts/materials-science-skills-for-llm-maintenance.mjs check",
    "tooluniverse-maintenance:artifacts": "node scripts/tooluniverse-maintenance.mjs artifacts",
    "tooluniverse-maintenance:records": "node scripts/tooluniverse-maintenance.mjs records",
    "tooluniverse-maintenance:baseline": "node scripts/tooluniverse-maintenance.mjs baseline",
    "tooluniverse-maintenance:check": "node scripts/tooluniverse-maintenance.mjs check",
    "scientific-agent-skills-maintenance:artifacts": "node scripts/scientific-agent-skills-maintenance.mjs artifacts",
    "scientific-agent-skills-maintenance:records": "node scripts/scientific-agent-skills-maintenance.mjs records",
    "scientific-agent-skills-maintenance:baseline": "node scripts/scientific-agent-skills-maintenance.mjs baseline",
    "scientific-agent-skills-maintenance:check": "node scripts/scientific-agent-skills-maintenance.mjs check",
    "education-agent-skills-maintenance:artifacts": "node scripts/education-agent-skills-maintenance.mjs artifacts",
    "education-agent-skills-maintenance:records": "node scripts/education-agent-skills-maintenance.mjs records",
    "education-agent-skills-maintenance:baseline": "node scripts/education-agent-skills-maintenance.mjs baseline",
    "education-agent-skills-maintenance:check": "node scripts/education-agent-skills-maintenance.mjs check",
    "arsu-maintenance:artifacts": "node scripts/arsu-maintenance.mjs artifacts",
    "arsu-maintenance:records": "node scripts/arsu-maintenance.mjs records",
    "paper-humanizer:author": "pnpm build && node dist/src/arsu-converter/authoring/paper-humanizer-cli.js",
    "revision-master:author": "pnpm build && node dist/src/arsu-converter/authoring/revision-master-cli.js",
    "own-vendor-maintenance:artifacts": "node scripts/own-vendor-maintenance.mjs artifacts",
    "own-vendor-maintenance:records": "node scripts/own-vendor-maintenance.mjs records",
    "own-vendor-maintenance:baseline": "node scripts/own-vendor-maintenance.mjs baseline",
    "own-vendor-maintenance:check": "node scripts/own-vendor-maintenance.mjs check"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.0.0",
    "@types/markdown-it": "^14.1.2",
    "eslint": "^9.37.0",
    "markdown-it": "^14.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.46.1"
  },
  "dependencies": {
    "@inquirer/core": "^10.3.2",
    "@inquirer/prompts": "^7.10.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fflate": "^0.8.3",
    "ora": "^8.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
