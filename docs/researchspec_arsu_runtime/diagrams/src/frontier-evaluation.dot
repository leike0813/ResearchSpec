digraph frontier_evaluation {
  graph [label="Workflow frontier is derived, not stored", labelloc=t, rankdir=LR, fontname="DejaVu Sans"];
  node [shape=box, style="rounded", fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans"];

  subgraph cluster_inputs {
    label="Trusted inputs";
    profile [label="workflow profile\ntemplates / DAG / Gates / transitions"];
    state [label="state.yaml\ninstances / active stages"];
    registry [label="artifact registry\npaths / hashes / producers"];
    ledgers [label="Gate + Decision ledgers"];
    receipts [label="trusted receipts"];
    contracts [label="stable specs"];
  }

  evaluator [shape=component, label="workflow evaluator"];
  dependencies [label="work dependencies\nparallel capacity + join"];
  completion [label="artifact completion\nregistry + hash + receipt"];
  gates [label="Gate readiness / pass / override"];
  transitions [label="unique / branch / blocked transition"];
  frontier [shape=folder, label="canonical frontier\nsubflow / work / gate / transition"];
  status [shape=note, label="status + scoped instructions"];

  profile -> evaluator;
  state -> evaluator;
  registry -> evaluator;
  ledgers -> evaluator;
  receipts -> evaluator;
  contracts -> evaluator;
  evaluator -> dependencies;
  evaluator -> completion;
  dependencies -> gates;
  completion -> gates;
  gates -> transitions;
  transitions -> frontier;
  frontier -> status;
}
