digraph transaction_write_sets {
  graph [label="Strict compatibility: receipt first, authority last", labelloc=t, rankdir=LR, fontname="DejaVu Sans"];
  node [shape=box, style="rounded", fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans"];

  start [label="Start"];
  submit [label="Work Submit"];
  gate [label="Gate Submit"];
  advance [label="Advance"];
  decide [label="Decide / Apply"];

  start_receipt [label="Start receipt"];
  submit_receipt [label="Submit receipt"];
  gate_receipt [label="Gate receipt"];
  transition_receipt [label="Transition receipt"];
  apply_receipt [label="Apply receipt"];

  state [shape=cylinder, label="state.yaml"];
  registry [shape=cylinder, label="artifact registry"];
  gate_ledger [shape=cylinder, label="Gate ledger"];
  decision_ledger [shape=cylinder, label="Decision ledger"];
  targets [shape=folder, label="stable spec / revised draft\n+ lifecycle"];

  start -> start_receipt -> state [label="authority last"];
  submit -> submit_receipt -> registry [label="authority last"];
  gate -> gate_receipt -> gate_ledger [label="append last"];
  advance -> transition_receipt -> state [label="authority last"];
  decide -> apply_receipt -> targets -> registry -> decision_ledger [label="append last"];
}
