@startuml
title ResearchSpec 与 ARSU 当前架构
skinparam componentStyle rectangle
skinparam shadowing false
actor Researcher
rectangle "Host Agent" as Host
package "Semantic plane" {
  component "4 ARSU Skills" as ARSU
  component "4 Companion Skills" as Companion
  component "7 Zotero Adapter Skills" as Zotero
  component "Optional domain Skills" as Plugins
}
package "Deterministic control plane" {
  component "ResearchSpec CLI\n16 commands" as CLI
  component "Current workspace scanner" as Scanner
}
database "Stable specs\nproject profile\nsubflow controls + handoffs\nproject changes" as Files
package "Build time" {
  component "ARSU converter" as Converter
  artifact "routing catalog\nprofile projection\ngenerated Skills" as Projection
}
Researcher --> Host
Host --> ARSU
Host --> Companion
ARSU --> Zotero
ARSU --> Plugins
Host --> CLI
CLI --> Scanner
Scanner --> Files
CLI --> Files : atomic owning-control writes
ARSU --> Files : specs / changes / handoff
Converter --> Projection
Projection ..> ARSU
note right of Files
  Boundary deliverables remain
  outside researchspec/.
end note
@enduml
