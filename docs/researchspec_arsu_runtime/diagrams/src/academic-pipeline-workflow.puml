@startuml
title Academic Pipeline current control graph
skinparam shadowing false
start
:Confirm pipeline parent;
:Start parent control;
:Confirm and start deep-research child;
:Join research handoff;
:Confirm and start academic-paper child;
:Join manuscript handoff;
:Produce integrity report;
:Human confirms integrity Gate;
:Confirm and start reviewer child;
:Human confirms review Gate and branch Decision;
while (revision required?) is (yes)
  :Confirm and start revision round;
  :Confirm revision child;
  :Confirm re-review child;
  :Human confirms round outcome;
endwhile (accepted)
:Human confirms final integrity Gate;
:Confirm formatting child;
:Produce process summary;
:Advance parent to complete;
stop
@enduml
