@startuml
title Academic Pipeline：当前 end-to-end 控制图
skinparam shadowing false
start
:Human + Host Agent\nconfirm route, graph, Gates and cost;
:CLI Start\nwrite receipt, then parent instance state;
:ARSU child\ndeep-research:full;
:CLI transition\nresearch -> write;
:ARSU child\nacademic-paper:full;
:CLI transition\nwrite -> pre-review;
:academic-pipeline producer\nwrite integrity_report;
:Verify + Human\nconfirm pre-review integrity Gate;
:CLI transition\npre-review -> review;
:ARSU child\nacademic-paper-reviewer:full;
:Verify + Human\nconfirm review Gate;
while (workflow_branch Decision = revision?) is (yes)
  :CLI Start\ndynamic revision round n;
  :ARSU child\nacademic-paper:revision;
  :CLI transition\nrevise -> re-review;
  :ARSU child\nacademic-paper-reviewer:re-review;
  :Human Decide\nrevision-outcome;
endwhile (accepted)
:academic-pipeline producer\nwrite final_integrity_report;
:Verify + Human\nconfirm final-integrity Gate;
:ARSU child\nacademic-paper:format-convert;
:academic-pipeline producer\nwrite process_summary;
:CLI complete transition\nwrite receipt, then state;
:Workspace retains\nstate, registry, ledgers and receipts;
note right
  academic-pipeline consumes CLI frontier.
  It does not maintain a second operational state.
end note
stop
@enduml
